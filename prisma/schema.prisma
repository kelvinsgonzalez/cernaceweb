// Esquema de datos de CERNACE.
// Prisma 7: el generador es `prisma-client` y el cliente se importa desde la
// ruta generada (src/generated/prisma), no desde "@prisma/client".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Sexo {
  MASCULINO
  FEMENINO
}

enum EstadoBeneficiario {
  ACTIVO
  INACTIVO
  EGRESADO
}

enum EstadoExpediente {
  COMPLETO
  EN_REVISION
  INCOMPLETO
}

enum NivelVulnerabilidad {
  BAJO
  MEDIO
  ALTO
}

enum EstadoDonacion {
  PENDIENTE
  COMPLETADA
  FALLIDA
  REEMBOLSADA
}

/// De dónde viene un aporte: la cuota de un padrino a su ahijado, una campaña
/// concreta, o la general «Aportar a lo que se necesite».
enum TipoAporte {
  APADRINAMIENTO
  CAMPANA
  GENERAL
}

enum EstadoSolicitud {
  NUEVA
  EN_REVISION
  APROBADA
  RECHAZADA
}

enum ModalidadPadrinazgo {
  MENSUAL
  TRIMESTRAL
  ANUAL
  UNICO
}

enum EstadoPublicacion {
  BORRADOR
  PUBLICADO
}

enum TipoIngreso {
  PRIMER_INGRESO
  REINGRESO
}

enum SituacionLaboral {
  EMPLEADO
  DESEMPLEADO
}

// ---------------------------------------------------------------------------
// Acceso: usuarios, roles y permisos (los permisos viven en la base)
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  nombre       String
  email        String     @unique
  passwordHash String
  cargo        String?
  /// Reseña profesional breve. La llena quien administra el equipo y la lee
  /// quien arma el equipo responsable de un niño.
  curriculum   String?
  activo       Boolean    @default(true)
  ultimoAcceso DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  roles        UserRole[]
  padrino      Padrino?
  asignaciones AsignacionTerapeuta[]
  planesAprobados PlanTerapeutico[]
  avancesRegistrados Seguimiento[]
  comentarios  ComentarioAvance[]
  documentos   Documento[]
  fotosExpediente FotoExpediente[]
  beneficiario Beneficiario?
  /// Aportes hechos con la sesión abierta (familias u otras cuentas que
  /// aportan a una campaña desde la portada).
  aportes      Donacion[]

  @@map("usuarios")
}

model Role {
  id          String           @id @default(cuid())
  clave       String           @unique
  nombre      String
  descripcion String?
  createdAt   DateTime         @default(now())
  usuarios    UserRole[]
  permisos    RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  clave       String           @unique
  nombre      String
  descripcion String?
  modulo      String
  roles       RolePermission[]

  @@map("permisos")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("usuarios_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("roles_permisos")
}

// ---------------------------------------------------------------------------
// Beneficiarios y expediente
// ---------------------------------------------------------------------------

/// Programas que el centro presenta en el sitio público. Son un referente de
/// la landing y nada más: no atan a ningún beneficiario. Lo que recibe cada
/// niño se anota en su expediente como terapias (`TerapiaBeneficiario`).
model Programa {
  id             String         @id @default(cuid())
  nombre         String
  descripcion    String
  icono          String         @default("HeartHandshake")
  activo         Boolean        @default(true)
  createdAt      DateTime       @default(now())

  @@map("programas")
}

model Beneficiario {
  id                String             @id @default(cuid())
  codigoExpediente  String             @unique
  nombres           String
  apellidos         String
  fechaNacimiento   DateTime           @db.Date
  sexo              Sexo
  cui               String?            @unique
  lugarNacimiento   String?
  idiomaHogar       String?
  tipoSangre        String?
  direccion         String?
  municipio         String
  departamento      String
  zonaResidencia    String?
  sector            String?
  escolaridad       String?
  telefono          String?
  encargadoId       String?
  /// Cuenta con la que la familia consulta el expediente. Es de solo lectura:
  /// la ficha la llena el personal.
  userId            String?            @unique
  fechaIngreso      DateTime           @db.Date
  /// Centro donde recibe la terapia. CERNACE atiende en dos centros de apoyo
  /// del municipio de Cuilco, Huehuetenango: San Pedro y Posonicapa. Es texto
  /// libre para poder abrir otro sin migración; el predeterminado es San Pedro.
  centroAtencion    String             @default("San Pedro")
  estado            EstadoBeneficiario @default(ACTIVO)
  estadoExpediente  EstadoExpediente   @default(EN_REVISION)
  /// Lo pide la familia al inscribirse: quiere que se le busque patrocinador.
  /// Es una petición, no una autorización, y no condiciona la terapia.
  solicitaPatrocinio Boolean           @default(false)
  /// Lo concede la administración: autoriza que los datos generales y la foto
  /// salgan en el sitio público. Hacen falta las dos cosas para aparecer.
  publicadoEnGaleria Boolean           @default(false)
  resumenPublico    String?
  /// Nombre del archivo en el almacenamiento, nunca una ruta de public/: así
  /// retirar la autorización deja la foto inaccesible de inmediato.
  fotoArchivo       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  encargado         Encargado?         @relation(fields: [encargadoId], references: [id], onDelete: SetNull)
  usuario           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  inscripciones     Inscripcion[]
  terapias          TerapiaBeneficiario[]
  plan              PlanTerapeutico?
  responsables      AsignacionTerapeuta[]
  expedienteClinico ExpedienteClinico?
  fichaSocioeconomica FichaSocioeconomica?
  evaluaciones      EvaluacionClinica[]
  documentos        Documento[]
  fotosExpediente   FotoExpediente[]
  seguimientos      Seguimiento[]
  citas             Cita[]
  padrinazgos       Padrinazgo[]
  aportes           Donacion[]
  solicitud         SupportRequest?

  @@index([encargadoId])
  @@map("beneficiarios")
}

/// Terapias que recibe un beneficiario, en sus propias palabras: un nombre y,
/// si hace falta, una explicación más larga. Son varias por niño y se llevan
/// desde su expediente; sustituyen al programa único de antes.
model TerapiaBeneficiario {
  id             String       @id @default(cuid())
  beneficiarioId String
  nombre         String
  detalle        String?
  orden          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)

  @@index([beneficiarioId])
  @@map("terapias_beneficiario")
}

/// El encargado vive aparte del beneficiario porque un mismo adulto puede
/// tener a varios hermanos a su cargo y sus datos no deben duplicarse.
///
/// `edad` se guarda tal cual la recoge la ficha: a diferencia del beneficiario,
/// del encargado no se pide fecha de nacimiento, así que es una foto del
/// momento de la inscripción y se vuelve a preguntar en cada ciclo.
model Encargado {
  id                   String            @id @default(cuid())
  nombre               String
  parentesco           String?
  sexo                 Sexo?
  edad                 Int?
  noIdentificacion     String?
  estadoCivil          String?
  situacionLaboral     SituacionLaboral?
  escolaridad          String?
  oficio               String?
  integrantesFamilia   Int?
  direccion            String?
  telefono             String?
  email                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  beneficiarios        Beneficiario[]

  @@index([noIdentificacion])
  @@map("encargados")
}

/// Ficha de inscripción de un ciclo. El beneficiario se reinscribe cada año,
/// así que hay una fila por ciclo y el par beneficiario-ciclo es único.
///
/// `impresionClinica` y `otrasEnfermedades` son datos clínicos: se leen solo
/// con el permiso expediente.clinico.leer, igual que el resto del área médica.
model Inscripcion {
  id                      String       @id @default(cuid())
  beneficiarioId          String
  ciclo                   Int
  fechaInscripcion        DateTime     @db.Date
  tipoIngreso             TipoIngreso
  fechaPrimerIngreso      DateTime?    @db.Date
  referidoPor             String?
  areaServicio            String?
  impresionClinica        String?
  otrasEnfermedades       String?
  responsableInscripcion  String
  voBo                    String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  beneficiario            Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)

  @@unique([beneficiarioId, ciclo])
  @@index([ciclo])
  @@map("inscripciones")
}

model ExpedienteClinico {
  id                  String       @id @default(cuid())
  beneficiarioId      String       @unique
  diagnosticoPrincipal String
  codigoCie10         String?
  fechaDiagnostico    DateTime?    @db.Date
  tipoDiscapacidad    String
  gradoDependencia    String
  medicoTratante      String?
  alergias            String?
  medicamentos        String?
  antecedentes        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  beneficiario        Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)

  @@map("expedientes_clinicos")
}

model EvaluacionClinica {
  id             String       @id @default(cuid())
  beneficiarioId String
  fecha          DateTime     @db.Date
  tipo           String
  profesional    String
  resultado      String
  documento      String?
  createdAt      DateTime     @default(now())
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)

  @@index([beneficiarioId])
  @@map("evaluaciones_clinicas")
}

model FichaSocioeconomica {
  id                   String              @id @default(cuid())
  beneficiarioId       String              @unique
  integrantesHogar     Int
  ingresoMensual       Decimal             @db.Decimal(10, 2)
  fuenteIngreso        String
  tipoVivienda         String
  materialConstruccion String
  escolaridadEncargado String
  serviciosBasicos     String[]
  observaciones        String?
  nivelVulnerabilidad  NivelVulnerabilidad
  elegibleBeca         Boolean             @default(false)
  fechaEstudio         DateTime            @db.Date
  realizadoPor         String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  beneficiario         Beneficiario        @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)

  @@map("fichas_socioeconomicas")
}

model Documento {
  id              String       @id @default(cuid())
  beneficiarioId  String
  nombre          String
  categoria       String
  tipoMime        String
  tamanoBytes     Int
  /// Nombre del archivo en el almacenamiento. Nulo si es un registro histórico
  /// sin adjunto: la fila documenta que el papel existe aunque no esté escaneado.
  archivo         String?
  /// Igual que en los avances: por defecto el documento es interno y solo se
  /// comparte si alguien lo decide expresamente. Compartir alcanza al padrino
  /// y a la familia.
  visibleParaPadrino Boolean   @default(false)
  vigente         Boolean      @default(true)
  fechaVencimiento DateTime?   @db.Date
  subidoPor       String
  subidoPorId     String?
  createdAt       DateTime     @default(now())
  beneficiario    Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  autor           User?        @relation(fields: [subidoPorId], references: [id], onDelete: SetNull)

  @@index([beneficiarioId])
  @@map("documentos")
}

/// `visibleParaPadrino` decide qué sale del equipo. Lo ven el padrino en su
/// portal y la familia en el suyo: son el mismo público, el de fuera del
/// equipo. Los comentarios del avance no salen nunca.
model Seguimiento {
  id                 String       @id @default(cuid())
  beneficiarioId     String
  fecha              DateTime     @db.Date
  area               String
  titulo             String
  descripcion        String
  visibleParaPadrino Boolean      @default(false)
  /// Nombre tal como estaba al registrarlo: el histórico no cambia aunque la
  /// persona se renombre o se dé de baja. `registradoPorId` es el enlace vivo.
  registradoPor      String
  registradoPorId    String?
  createdAt          DateTime     @default(now())
  beneficiario       Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  autor              User?        @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)
  fotos              FotoAvance[]
  comentarios        ComentarioAvance[]

  @@index([beneficiarioId])
  @@index([registradoPorId])
  @@map("seguimientos")
}

/// Aprobación para que un beneficiario reciba terapia. El objetivo general y
/// las anotaciones los lee todo el equipo responsable, no solo quien las
/// escribió: son el marco común de trabajo.
model PlanTerapeutico {
  id              String       @id @default(cuid())
  beneficiarioId  String       @unique
  objetivoGeneral String
  anotaciones     String?
  activo          Boolean      @default(true)
  aprobadoPor     String
  aprobadoPorId   String?
  fechaAprobacion DateTime     @db.Date
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  beneficiario    Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  aprobador       User?        @relation(fields: [aprobadoPorId], references: [id], onDelete: SetNull)

  @@map("planes_terapeuticos")
}

/// Responsables de atender a un beneficiario. Es N:M a propósito: un niño puede
/// recibir varias terapias de personas distintas, y una persona lleva varios
/// niños. La asignación decide quién puede registrar avances suyos.
model AsignacionTerapeuta {
  id             String       @id @default(cuid())
  beneficiarioId String
  terapeutaId    String
  area           String?
  activo         Boolean      @default(true)
  desde          DateTime     @db.Date
  hasta          DateTime?    @db.Date
  asignadoPor    String
  createdAt      DateTime     @default(now())
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  terapeuta      User         @relation(fields: [terapeutaId], references: [id], onDelete: Cascade)

  @@unique([beneficiarioId, terapeutaId])
  @@index([terapeutaId])
  @@map("asignaciones_terapeutas")
}

/// Foto adjunta a una reseña de avance. `archivo` es el nombre en disco: los
/// ficheros viven fuera de public/ y se sirven por una ruta que comprueba el
/// permiso, para que la foto de un niño no quede accesible por su URL.
/// Fotografía de evidencia del expediente.
///
/// Es distinta de la foto principal —que vive en el propio beneficiario porque
/// es una sola y es la que sale en el sitio cuando se le busca padrino— y de
/// las fotos de un avance, que ilustran una reseña concreta. Estas documentan
/// el caso: la condición al ingresar, una visita domiciliar, una ayuda
/// entregada. Son internas salvo que se marquen compartidas.
model FotoExpediente {
  id                 String       @id @default(cuid())
  beneficiarioId     String
  archivo            String       @unique
  tipoMime           String
  tamanoBytes        Int
  descripcion        String?
  visibleParaPadrino Boolean      @default(false)
  subidaPor          String
  subidaPorId        String?
  createdAt          DateTime     @default(now())
  beneficiario       Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  autor              User?        @relation(fields: [subidaPorId], references: [id], onDelete: SetNull)

  @@index([beneficiarioId])
  @@map("fotos_expediente")
}

model FotoAvance {
  id            String      @id @default(cuid())
  seguimientoId String
  archivo       String      @unique
  tipoMime      String
  tamanoBytes   Int
  createdAt     DateTime    @default(now())
  seguimiento   Seguimiento @relation(fields: [seguimientoId], references: [id], onDelete: Cascade)

  @@index([seguimientoId])
  @@map("fotos_avances")
}

/// Conversación del equipo alrededor de un avance. Es interna por decisión:
/// el padrino ve el avance, no lo que los compañeros comentan sobre él, que es
/// justamente lo que permite escribir con franqueza.
model ComentarioAvance {
  id            String      @id @default(cuid())
  seguimientoId String
  texto         String
  /// Nombre en el momento de escribirlo; `autorId` es el enlace vivo.
  autor         String
  autorId       String?
  createdAt     DateTime    @default(now())
  seguimiento   Seguimiento @relation(fields: [seguimientoId], references: [id], onDelete: Cascade)
  usuario       User?       @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([seguimientoId])
  @@map("comentarios_avances")
}

model Cita {
  id             String       @id @default(cuid())
  beneficiarioId String
  fecha          DateTime
  tipo           String
  profesional    String
  createdAt      DateTime     @default(now())
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)

  @@index([beneficiarioId])
  @@map("citas")
}

// ---------------------------------------------------------------------------
// Padrinos, donaciones y campañas
// ---------------------------------------------------------------------------

model Padrino {
  id          String       @id @default(cuid())
  userId      String?      @unique
  nombre      String
  email       String       @unique
  telefono    String?
  direccion   String?
  ocupacion   String?
  nit         String?
  activo      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  padrinazgos Padrinazgo[]
  donaciones  Donacion[]

  @@map("padrinos")
}

model Padrinazgo {
  id             String              @id @default(cuid())
  padrinoId      String
  beneficiarioId String
  /// Aporte mensual de referencia. No es una cuota: el aporte es voluntario y
  /// esta cifra solo alimenta la barra de ánimo de la ficha del niño.
  aporteMensual  Decimal             @db.Decimal(10, 2)
  /// Ya no se usa en pantalla; se conserva por los datos anteriores.
  modalidad      ModalidadPadrinazgo @default(MENSUAL)
  activo         Boolean             @default(true)
  fechaInicio    DateTime            @db.Date
  fechaFin       DateTime?           @db.Date
  /// Caducidad opcional del compromiso. Al llegar, nada pasa solo: aparece en
  /// el panel y el administrador decide.
  caducaEl       DateTime?           @db.Date
  /// Tras seis meses sin aporte el administrador puede suspender los avances:
  /// el padrino sigue asignado pero no ve el progreso hasta que se reactive.
  avancesSuspendidos Boolean         @default(false)
  /// Cuándo el administrador atendió por última vez el aviso de seis meses
  /// («Mantener»): el aviso no vuelve a salir hasta seis meses después.
  avisoAtendidoEl DateTime?
  createdAt      DateTime            @default(now())
  padrino        Padrino             @relation(fields: [padrinoId], references: [id], onDelete: Cascade)
  beneficiario   Beneficiario        @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  aportes        Donacion[]

  @@unique([padrinoId, beneficiarioId])
  @@index([beneficiarioId])
  @@map("padrinazgos")
}

model Donacion {
  id                 String         @id @default(cuid())
  // Opcionales: el donativo directo se sube sin identificarse. Solo los
  // aportes que pasan por la pasarela o que registra el equipo traen donante.
  donanteNombre      String?
  donanteEmail       String?
  padrinoId          String?
  campaignId         String?
  /// Cuota de apadrinamiento, campaña o general. Se fija al crear el aporte.
  tipo               TipoAporte     @default(GENERAL)
  /// El niño real al que va el aporte. Desde el portal lo pone el servidor;
  /// desde la portada lo empareja el administrador al verificar.
  beneficiarioId     String?
  /// El compromiso al que corresponde, cuando el aporte es de un padrino.
  padrinazgoId       String?
  /// Cuenta con la sesión abierta que hizo el aporte, si la hubo.
  usuarioId          String?
  /// El mensaje de amor (`mensaje`) llega a la familia solo cuando el
  /// administrador aprueba el aporte y marca esta casilla.
  mensajeVisibleFamilia Boolean     @default(false)
  // Texto libre con el código o el nombre del niño al que el donante dirige
  // su aporte. No es una relación: el donante escribe lo que recuerda y el
  // equipo lo empareja a mano con el expediente.
  destinoNino        String?
  // Nulo mientras no se sepa: el donativo directo llega sin monto y lo anota
  // el equipo al cotejar la boleta contra el estado de cuenta.
  monto              Decimal?       @db.Decimal(10, 2)
  moneda             String         @default("GTQ")
  metodo             String
  estado             EstadoDonacion @default(PENDIENTE)
  referenciaPasarela String         @unique
  recurrente         Boolean        @default(false)
  mensaje            String?
  // Comprobante del banco: solo lo traen la transferencia y el depósito. El
  // archivo vive fuera de public/ y se entrega por /api/boletas/[id].
  boletaArchivo      String?
  boletaTipoMime     String?
  boletaTamanoBytes  Int?
  boletaBanco        String?
  boletaNumero       String?
  boletaFecha        DateTime?      @db.Date
  boletaSubidaEn     DateTime?
  // Quién dio por buena la boleta en el panel, y cuándo.
  verificadaPor      String?
  verificadaEn       DateTime?
  notaVerificacion   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  padrino            Padrino?       @relation(fields: [padrinoId], references: [id], onDelete: SetNull)
  campaign           Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  beneficiario       Beneficiario?  @relation(fields: [beneficiarioId], references: [id], onDelete: SetNull)
  padrinazgo         Padrinazgo?    @relation(fields: [padrinazgoId], references: [id], onDelete: SetNull)
  usuario            User?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([beneficiarioId])
  @@index([padrinoId])
  @@index([campaignId])
  @@map("donaciones")
}

model Campaign {
  id          String     @id @default(cuid())
  titulo      String
  slug        String     @unique
  /// La frase que sale en la portada.
  resumen     String?
  descripcion String
  meta        Decimal    @db.Decimal(10, 2)
  fechaInicio DateTime   @db.Date
  fechaFin    DateTime?  @db.Date
  activa      Boolean    @default(true)
  /// La campaña permanente «Aportar a lo que se necesite»: sin meta ni fecha,
  /// siempre visible y no se cierra. Hay una sola.
  general     Boolean    @default(false)
  imagenUrl   String?
  /// Borrado lógico. Eliminada, desaparece del panel y de la portada y pierde
  /// sus fotos, pero la fila sigue para que los informes conserven su nombre
  /// y lo recaudado.
  eliminadaEn DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  donaciones  Donacion[]
  fotos       CampaignFoto[]

  @@map("campanas")
}

/// Fotos de una campaña. Viven fuera de public/ como las de las historias y
/// se sirven por /api/campanas/fotos/[id].
model CampaignFoto {
  id          String   @id @default(cuid())
  campaignId  String
  archivo     String
  tipoMime    String
  alt         String?
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("fotos_campana")
}

// ---------------------------------------------------------------------------
// Contenido
// ---------------------------------------------------------------------------

model Story {
  id           String            @id @default(cuid())
  titulo       String
  slug         String            @unique
  resumen      String
  contenido    String
  protagonista String
  programa     String?
  /// Ruta estática bajo public/: es como llegaron las historias del seed.
  imagenUrl    String?
  /// Foto subida desde /admin/historias. Vive fuera de public/ y se sirve por
  /// /api/historias/[id]/imagen; manda sobre `imagenUrl` cuando las dos están.
  imagenArchivo  String?
  imagenTipoMime String?
  imagenAlt      String?
  /// Posición en la franja de la landing: menor primero. La landing publica
  /// seis como mucho (MAXIMO_HISTORIAS en src/lib/historias.ts).
  orden        Int               @default(0)
  estado       EstadoPublicacion @default(PUBLICADO)
  publicadaEn  DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("historias")
}

model Post {
  id          String            @id @default(cuid())
  titulo      String
  slug        String            @unique
  resumen     String
  contenido   String
  autor       String
  categoria   String
  estado      EstadoPublicacion @default(PUBLICADO)
  publicadoEn DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("entradas_blog")
}

model Media {
  id          String   @id @default(cuid())
  nombre      String
  url         String
  tipoMime    String
  tamanoBytes Int
  alt         String?
  subidoPor   String
  createdAt   DateTime @default(now())

  @@map("medios")
}

// ---------------------------------------------------------------------------
// Formularios entrantes
// ---------------------------------------------------------------------------

/// Inscripción de beneficiarios enviada desde el sitio público.
model SupportRequest {
  id                  String          @id @default(cuid())
  nombreNino          String
  fechaNacimiento     DateTime        @db.Date
  sexo                Sexo
  municipio           String
  departamento        String
  encargadoNombre     String
  encargadoParentesco String
  encargadoTelefono   String
  encargadoEmail      String?
  diagnostico         String?
  programaSolicitado  String?
  comentarios         String?
  estado              EstadoSolicitud @default(NUEVA)
  notaInterna         String?
  /// Expediente que salió de esta solicitud al aceptarla. Mientras sea null la
  /// solicitud no se ha convertido, y es lo que impide abrir dos expedientes
  /// para el mismo niño desde el mismo formulario.
  beneficiarioId      String?         @unique
  /// Archivar la saca de las listas de trabajo sin borrarla: queda solo en el
  /// historial. Se puede archivar en cualquier momento, también sin atender,
  /// para descartar duplicados o envíos que no van a proceder.
  archivada           Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  beneficiario        Beneficiario?   @relation(fields: [beneficiarioId], references: [id], onDelete: SetNull)

  @@map("solicitudes_inscripcion")
}

/// Inscripción de padrinos y de voluntariado enviada desde el sitio público.
model VolunteerApplication {
  id           String          @id @default(cuid())
  nombre       String
  email        String
  telefono     String
  tipo         String
  ocupacion    String?
  disponibilidad String?
  aporteMensual Decimal?       @db.Decimal(10, 2)
  motivacion   String?
  estado       EstadoSolicitud @default(NUEVA)
  notaInterna  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("postulaciones")
}

model ContactMessage {
  id        String          @id @default(cuid())
  nombre    String
  email     String
  telefono  String?
  asunto    String
  mensaje   String
  estado    EstadoSolicitud @default(NUEVA)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("mensajes_contacto")
}

// ---------------------------------------------------------------------------
// Configuración y auditoría
// ---------------------------------------------------------------------------

model Setting {
  id          String   @id @default(cuid())
  clave       String   @unique
  valor       String
  descripcion String?
  grupo       String   @default("general")
  updatedAt   DateTime @updatedAt

  @@map("configuracion")
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  accion    String
  entidad   String
  entidadId String?
  detalle   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entidad])
  @@index([accion])
  @@map("bitacora")
}
